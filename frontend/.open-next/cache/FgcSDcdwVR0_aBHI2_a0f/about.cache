tp://localhost:3000/favicon.png\"/><link rel=\"shortcut icon\" href=\"/favicon.png\"/><link rel=\"icon\" href=\"/favicon.png\" type=\"image/png\"/><link rel=\"apple-touch-icon\" href=\"/favicon.png\"/><link href=\"https://fonts.googleapis.com/icon?family=Material+Icons\" rel=\"stylesheet\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"name\":\"Boi Pora\",\"alternateName\":\"বই পড়া\",\"description\":\"Boi Pora (বই পড়া) is your digital reading companion — discover books, read chapters with a focused reader, build your library, and track progress. Bengali and multilingual-friendly.\",\"url\":\"http://localhost:3000\",\"inLanguage\":[\"bn\",\"en\"]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__variable_246ccd __variable_4c40f6 __variable_f9d2a6 __variable_a6078f antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><div class=\"flex min-h-dvh flex-col\"><nav class=\"sticky top-0 z-50 bg-background-light/90 dark:bg-background-dark/90 backdrop-blur-md border-b border-neutral-200 dark:border-neutral-800\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex justify-between h-16 sm:h-20 items-center gap-2\"><a class=\"shrink-0 flex items-center gap-2 min-w-0\" href=\"/\"><span class=\"material-icons text-primary text-2xl sm:text-3xl shrink-0\">auto_stories</span><span class=\"font-bold text-lg sm:text-xl tracking-tight text-neutral-800 dark:text-white truncate\">Boi Pora</span></a><div class=\"hidden md:flex space-x-10 items-center\"><a class=\"text-neutral-600 dark:text-neutral-300 hover:text-primary transition-colors font-medium\" href=\"/explore\">Explore</a><a class=\"text-neutral-600 dark:text-neutral-300 hover:text-primary transition-colors font-medium\" href=\"/library\">My Library</a></div><div class=\"flex items-center gap-1 sm:gap-4 shrink-0\"><form class=\"relative hidden sm:block\" action=\"/search\" method=\"get\"><span class=\"absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none\"><span class=\"material-icons text-neutral-400 text-lg\">search</span></span><input aria-label=\"Search books\" class=\"pl-10 pr-4 py-2 rounded-full border border-transparent bg-white dark:bg-surface-dark focus:bg-white focus:ring-2 focus:ring-primary text-sm w-48 transition-all placeholder-neutral-400\" placeholder=\"Search...\" type=\"search\" name=\"q\"/></form><button type=\"button\" class=\"p-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors\" aria-label=\"Toggle dark mode\"><span class=\"material-icons text-neutral-600 dark:text-neutral-300\">dark_mode</span></button><a class=\"flex items-center gap-1 sm:gap-2 px-3 sm:px-4 py-2 rounded-full bg-primary text-white text-sm font-medium hover:bg-primary/90 shrink-0\" href=\"/login\"><span class=\"material-icons text-base sm:text-lg\">login</span><span class=\"hidden sm:inline\">Sign in</span></a><button type=\"button\" class=\"md:hidden p-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors\" aria-expanded=\"false\" aria-controls=\"mobile-nav-menu\" aria-label=\"Open menu\"><span class=\"material-icons text-neutral-700 dark:text-neutral-200 text-2xl\" aria-hidden=\"true\">menu</span></button></div></div></div></nav><main class=\"flex flex-1 flex-col w-full min-h-0 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 animate-fade-in\"><section class=\"max-w-3xl mx-auto text-center mb-20\"><span class=\"material-icons text-5xl text-primary mb-4\">auto_stories</span><h1 class=\"text-4xl font-bold text-slate-900 dark:text-white mb-6\">About Boi Pora</h1><p class=\"text-lg text-slate-600 dark:text-slate-300 leading-relaxed\">Boi Pora is a digital reading platform dedicated to making books accessible to everyone. Our mission is to foster a love of reading by providing a curated library of books in multiple languages, with a seamless reading experience across all devices.</p></section><section class=\"grid grid-cols-2 md:grid-cols-4 gap-6 mb-20\"><div class=\"text-center p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-3xl text-primary mb-3\">auto_stories</span><p class=\"text-2xl font-bold text-slate-900 dark:text-white\">500+</p><p class=\"text-sm text-slate-500 dark:text-slate-400\">Books</p></div><div class=\"text-center p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-3xl text-primary mb-3\">people</span><p class=\"text-2xl font-bold text-slate-900 dark:text-white\">10,000+</p><p class=\"text-sm text-slate-500 dark:text-slate-400\">Readers</p></div><div class=\"text-center p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-3xl text-primary mb-3\">star</span><p class=\"text-2xl font-bold text-slate-900 dark:text-white\">25,000+</p><p class=\"text-sm text-slate-500 dark:text-slate-400\">Reviews</p></div><div class=\"text-center p-6 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-3xl text-primary mb-3\">category</span><p class=\"text-2xl font-bold text-slate-900 dark:text-white\">20+</p><p class=\"text-sm text-slate-500 dark:text-slate-400\">Categories</p></div></section><section class=\"max-w-3xl mx-auto mb-20\"><h2 class=\"text-2xl font-bold text-slate-900 dark:text-white mb-6\">Our Mission</h2><div class=\"space-y-4 text-slate-600 dark:text-slate-300 leading-relaxed\"><p>We believe that reading has the power to transform lives. Boi Pora was built to break down the barriers between readers and the books they love — whether those barriers are language, cost, or access.</p><p>Our platform offers a rich collection of books across genres like fiction, non-fiction, poetry, and more. Readers can explore, bookmark, review, and track their reading progress all in one place.</p></div></section><section class=\"max-w-3xl mx-auto mb-20\"><h2 class=\"text-2xl font-bold text-slate-900 dark:text-white mb-6\">What We Offer</h2><div class=\"grid sm:grid-cols-2 gap-6\"><div class=\"flex gap-4 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-2xl text-primary mt-0.5\">search</span><div><h3 class=\"font-semibold text-slate-900 dark:text-white mb-1\">Discover</h3><p class=\"text-sm text-slate-600 dark:text-slate-300\">Browse a curated collection of books across genres and languages.</p></div></div><div class=\"flex gap-4 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-2xl text-primary mt-0.5\">bookmark</span><div><h3 class=\"font-semibold text-slate-900 dark:text-white mb-1\">Library</h3><p class=\"text-sm text-slate-600 dark:text-slate-300\">Save books to your personal library and pick up where you left off.</p></div></div><div class=\"flex gap-4 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-2xl text-primary mt-0.5\">rate_review</span><div><h3 class=\"font-semibold text-slate-900 dark:text-white mb-1\">Reviews</h3><p class=\"text-sm text-slate-600 dark:text-slate-300\">Share your thoughts and read reviews from fellow readers.</p></div></div><div class=\"flex gap-4 p-5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-surface-dark\"><span class=\"material-icons text-2xl text-primary mt-0.5\">devices</span><div><h3 class=\"font-semibold text-slate-900 dark:text-white mb-1\">Read Anywhere</h3><p class=\"text-sm text-slate-600 dark:text-slate-300\">Enjoy a comfortable reading experience on any device, any time.</p></div></div></div></section><section class=\"max-w-3xl mx-auto\"><h2 class=\"text-2xl font-bold text-slate-900 dark:text-white mb-6\">Built With</h2><p class=\"text-slate-600 dark:text-slate-300 leading-relaxed\">Boi Pora is built with modern web technologies including Next.js, NestJS, MongoDB, and Tailwind CSS — designed for speed, reliability, and a great user experience.</p></section></div><!--$--><!--/$--></main><footer class=\"bg-white dark:bg-surface-dark border-t border-neutral-200 dark:border-neutral-800 py-12\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-6\"><div class=\"flex items-center gap-2\"><span class=\"material-icons text-primary text-2xl\">auto_stories</span><span class=\"font-bold text-lg tracking-tight text-neutral-800 dark:text-white\">Boi Pora</span></div><div class=\"flex gap-8 text-sm text-neutral-500\"><a class=\"hover:text-primary transition-colors\" href=\"/about\">About</a><a class=\"hover:text-primary transition-colors\" href=\"/privacy\">Privacy</a><a class=\"hover:text-primary transition-colors\" href=\"/terms\">Terms</a><a class=\"hover:text-primary transition-colors\" href=\"/contact\">Contact</a></div><p class=\"text-sm text-neutral-400\">© <!-- -->2026<!-- --> Boi Pora. All rights reserved.</p></div></footer></div><script src=\"/_next/static/chunks/webpack-142060f2dcba0155.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[80730,[\\\"7177\\\",\\\"static/chunks/app/layout-e9508147861c4729.js\\\"],\\\"AuthProvider\\\"]\\n3:I[60087,[\\\"7177\\\",\\\"static/chunks/app/layout-e9508147861c4729.js\\\"],\\\"ToastProvider\\\"]\\n4:I[57121,[],\\\"\\\"]\\n5:I[87460,[\\\"8039\\\",\\\"static/chunks/app/error-6224c21fb0a8f108.js\\\"],\\\"default\\\"]\\n6:I[74581,[],\\\"\\\"]\\n7:I[98500,[\\\"8500\\\",\\\"static/chunks/8500-f62a38ff68ab7f42.js\\\",\\\"9623\\\",\\\"static/chunks/9623-612d68567a877c49.js\\\",\\\"5359\\\",\\\"static/chunks/app/(public)/page-b8da5e0f82cab492.js\\\