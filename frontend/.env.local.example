# Main API (auth, library, admin) — Nest on port 4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public books read API — Hono / wrangler dev on port 8787
NEXT_PUBLIC_GET_API_URL=http://localhost:8787

# Site URL for Open Graph, Twitter cards, and canonical links (no trailing slash).
# In production, set to your real domain, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
