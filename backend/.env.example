# === Local Development ===
PORT=4000
MONGODB_URI=mongodb://localhost:27017/boi-pora
JWT_SECRET=change-this-to-a-secure-secret-in-production
CORS_ORIGIN=http://localhost:3000
# Refresh cookie SameSite policy. Default "lax" works when the frontend and API
# share a site (localhost, or a custom domain with an api. subdomain).
# Cross-site deployments (e.g. pages.dev frontend + onrender.com API) need "none".
# COOKIE_SAMESITE=lax
# NODE_ENV=development disables the Secure flag on the refresh cookie for local HTTP.
NODE_ENV=development
# Required for `npm run seed` (the script refuses to run without it — no default password)
ADMIN_SEED_PASSWORD=change-this-admin-password
# Optional admin email for seed (default: admin@boipora.com)
# ADMIN_SEED_EMAIL=admin@boipora.com

# Langbly translation (https://langbly.com/docs/) — Google Translate v2 compatible POST /language/translate/v2
# LANGBLY_API_KEY=
# Optional: EU-only base URL https://eu.langbly.com
# LANGBLY_API_BASE_URL=https://api.langbly.com
# Optional: milliseconds to wait between chunk requests (default 0). Increase only if you hit rate limits on huge texts.
# TRANSLATE_INTER_CHUNK_DELAY_MS=0

# Groq (https://console.groq.com/) — chapter AI summaries (OpenAI-compatible chat)
# GROQ_API_KEY=
# Optional model id (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# === Render Deployment ===
# Set these as Environment Variables in Render Dashboard:
#   MONGODB_URI  → Your MongoDB Atlas connection string (e.g. mongodb+srv://user:pass@cluster.mongodb.net/boi-pora)
#   JWT_SECRET   → Auto-generated if using render.yaml, or set a strong random secret (min 32 chars)
#   CORS_ORIGIN  → Your frontend URL (e.g. https://boi-pora.vercel.app). Comma-separated for multiple origins.
#   PORT         → Render sets this automatically (default 10000)
