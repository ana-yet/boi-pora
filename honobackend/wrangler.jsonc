{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honobackend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Non-secret defaults (safe to commit). Do not put MONGODB_URI here.

  "vars": {
    "DB_NAME": "boi-pora"
  },
  // Production deploy: pnpm deploy  →  wrangler deploy --env production
  "env": {
    "production": {
      "vars": {
        "CORS_ORIGIN": "https://boi-pora.mdanayet-kdk.workers.dev",
        "DB_NAME": "boi-pora",
        "BOOKS_API_PROXY": "https://boi-pora.onrender.com"
      }
    }
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}