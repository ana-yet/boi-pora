# Copy to honobackend/.env for `pnpm dev`

# Primary data source (required for production)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/boi-pora

# Optional fallback when MongoDB fails (local Nest on :4000)
BOOKS_API_PROXY=http://127.0.0.1:4000

DB_NAME=boi-pora
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
