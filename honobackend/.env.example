# Copy to honobackend/.env for `pnpm dev`

# --- Local dev (recommended): proxy books to Nest — avoids Mongo hanging inside Workers ---
BOOKS_API_PROXY=http://127.0.0.1:4000

# --- Direct Mongo (production / Atlas). Comment out BOOKS_API_PROXY when using this. ---
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/boi-pora
# For local Mongo, prefer 127.0.0.1 (not localhost) if you must connect from the Worker:
# MONGODB_URI=mongodb://127.0.0.1:27017/boi-pora

DB_NAME=boi-pora
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
